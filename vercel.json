{
  
  "$schema": "https://openapi.vercel.sh/vercel.json",
  
  "framework": "vite",
  
  "buildCommand": "pnpm build",
  
  "outputDirectory": "dist/public",
  
  "headers": [
    
    {
      
      "source": "/portfolio-media/(.*).mp4",
      
      "headers": [
        
        { "key": "Content-Type", "value": "video/mp4" },
        
        { "key": "Content-Disposition", "value": "inline" },
        
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
        
      ]
      
    },
    
    {
      
      "source": "/portfolio-media/(.*).mp3",
      
      "headers": [
        
        { "key": "Content-Type", "value": "audio/mpeg" },
        
        { "key": "Content-Disposition", "value": "inline" },
        
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
        
      ]
      
    },
    
    {
      
      "source": "/portfolio-media/(.*).webp",
      
      "headers": [
        
        { "key": "Content-Type", "value": "image/webp" },
        
        { "key": "Content-Disposition", "value": "inline" },
        
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
        
      ]
      
    },
    
    {
      
      "source": "/portfolio-media/(.*).png",
      
      "headers": [
        
        { "key": "Content-Type", "value": "image/png" },
        
        { "key": "Content-Disposition", "value": "inline" },
        
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
        
      ]
      
    },
    
    {
      
      "source": "/portfolio-media/(.*).pdf",
      
      "headers": [
        
        { "key": "Content-Type", "value": "application/pdf" },
        
        { "key": "Content-Disposition", "value": "inline" },
        
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
        
      ]
      
    }
    
  ],
  
  "rewrites": [
    
    {
      
      "source": "/portfolio-media/:asset*",
      
      "destination": "https://github.com/sikander1020/Award-Portfolio/releases/download/portfolio-media-v1/:asset*"
      
    },
    
    {
      
      "source": "/(.*)",
      
      "destination": "/index.html"
      
    }
    
  ]
  
}































































